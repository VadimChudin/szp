# Smart Zones Pro — Environment Configuration
# Copy this file to `.env` (in the same folder) and fill in your values.
# All variables are optional — sensible defaults are baked into the app.
# The application reads `.env` at startup; restart after editing.

# ─────────────────────────────────────────────────────────────────────────────
# Telegram bot — alerts on zone touches and daily summaries
# Create a bot via @BotFather in Telegram, paste the token below.
# To learn your chat id: send a message to your bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Trading instrument
# ─────────────────────────────────────────────────────────────────────────────
SYMBOL=XAUUSD
BROKER_UTC_OFFSET=3

# ─────────────────────────────────────────────────────────────────────────────
# Algorithm output limits
#   ZONES_PER_SIDE    — active slots per side; default 3 yields exactly six lines
#   ZONE_MAX_PER_SIDE — if one side has no real levels inside the window, the
#                       other side takes the free slots, but never more than this
#   MIN_ZONE_SCORE    — levels below this score are retained as fallback lines
# ─────────────────────────────────────────────────────────────────────────────
ZONES_PER_SIDE=3
ZONE_MAX_PER_SIDE=4
MIN_ZONE_SCORE=11

# ─────────────────────────────────────────────────────────────────────────────
# Display window — WHERE the zones are allowed to sit.
#
# The window sets BOUNDS ONLY, never a step. Inside the window the strongest
# real levels win, so the distance between zones is uneven — whatever the market
# actually produced. Forcing an even step put levels where arithmetic wanted
# them instead of where a wick cluster exists.
#
# The window is measured from price in EACH direction independently:
#   at price 4454 with 200-900 pips and PIP_SIZE=0.1 the app looks for zones in
#   4474..4544 above and 4364..4434 below, and draws nothing within +-$20.
#
#   PIP_SIZE                 — dollars per pip. NOT a universal constant: it is a
#                              platform convention. A broker quoting gold with 2
#                              decimals (4465.86) and one quoting 3 decimals
#                              (4059.306) disagree on what "one pip" means, so
#                              set this to match the client's terminal.
#                              0.1  -> window $20-90   (default)
#                              0.01 -> window $2-9
#   ZONE_MIN_DISTANCE_PIPS   — closer than this a zone hugs price: nothing to trade
#   ZONE_MAX_DISTANCE_PIPS   — farther than this the level is out of current range
#   ZONE_MIN_SEPARATION_PIPS — minimum gap between neighbouring lines, so they do
#                              not merge into one. This is NOT a step: zones may
#                              sit 170 pips apart in one place and 670 in another.
# ─────────────────────────────────────────────────────────────────────────────
PIP_SIZE=0.1
ZONE_MIN_DISTANCE_PIPS=200
ZONE_MAX_DISTANCE_PIPS=900
ZONE_MIN_SEPARATION_PIPS=100

# ─────────────────────────────────────────────────────────────────────────────
# Zones-only chart. Set to 1 to bring the extra objects back.
#   ACCUMULATION_ENABLED — violet big-player accumulation boxes
#   PROJECT_ROUND_LEVELS — synthetic round levels with no wick behind them
# Possible SL levels are controlled by the ShowSL input in the MQL indicator
# (false by default).
# ─────────────────────────────────────────────────────────────────────────────
ACCUMULATION_ENABLED=0
PROJECT_ROUND_LEVELS=0

# ─────────────────────────────────────────────────────────────────────────────
# Data source — "mt5" (live, via MetaTrader Python API) or "csv" (offline)
# ─────────────────────────────────────────────────────────────────────────────
DATA_SOURCE=mt5

# ─────────────────────────────────────────────────────────────────────────────
# Optional: override the install dir (only set if you moved the app
# after install and want to keep using its data files in-place).
# ─────────────────────────────────────────────────────────────────────────────
# SZP_BASE_DIR=C:\Program Files\SmartZonesPro

# ─────────────────────────────────────────────────────────────────────────────
# H4 incremental zone lifecycle
# The active snapshot changes only on a new closed H4 bar.
# TEST_INVALIDATES_ZONE=true removes a zone after a confirmed H4 test.
# ─────────────────────────────────────────────────────────────────────────────
TEST_INVALIDATES_ZONE=true
ZONE_EVENT_LOG_ENABLED=true

# Adaptive zone width: fixed, atr, or regime.
# Note: the width is clamped to fit inside ZONE_MIN_SEPARATION, otherwise
# neighbouring zones would visually merge.
ZONE_WIDTH_MODE=atr
ATR_PERIOD=14
ATR_MULTIPLIER=0.5
ZONE_WIDTH_MIN=0.50
ZONE_WIDTH_MAX=8.00
REGIME_ATR_LOW=2.0
REGIME_ATR_HIGH=6.0
