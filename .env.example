# Smart Zones Pro — Environment Configuration
# Copy this file to `.env` (in the same folder) and fill in your values.
# All variables are optional — sensible defaults are baked into the app.
# The application reads `.env` at startup; restart after editing.

# ─────────────────────────────────────────────────────────────────────────────
# Telegram bot — alerts on zone touches and daily summaries
# Create a bot via @BotFather in Telegram, paste the token below.
# To learn your chat id: send a message to your bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Trading instrument
# ─────────────────────────────────────────────────────────────────────────────
SYMBOL=XAUUSD
BROKER_UTC_OFFSET=3

# ─────────────────────────────────────────────────────────────────────────────
# Algorithm output limits
#   ZONES_PER_SIDE — active slots per side; default 3 yields exactly six lines
#   MIN_ZONE_SCORE  — levels below this score are retained as red fallback lines
# ─────────────────────────────────────────────────────────────────────────────
ZONES_PER_SIDE=3
MIN_ZONE_SCORE=11

# ─────────────────────────────────────────────────────────────────────────────
# Display band (restored ladder logic) — where the six zones are allowed to sit
#   PIP_SIZE               — dollars per pip on XAU/USD (0.1 for the client terminal)
#   ZONE_NEAREST_*_PIPS    — window for the closest zone on each side
#   ZONE_GAP_*_PIPS        — step from one zone to the next on the same side
#   ZONE_BAND_TOLERANCE    — slack used when no real wick sits inside a window
# The step is measured from the previously selected zone, so score can no longer
# drag the visible set out of the requested range.
# ─────────────────────────────────────────────────────────────────────────────
PIP_SIZE=0.1
ZONE_NEAREST_MIN_PIPS=200
ZONE_NEAREST_MAX_PIPS=300
ZONE_GAP_MIN_PIPS=200
ZONE_GAP_MAX_PIPS=300
ZONE_BAND_TOLERANCE=0.25

# ─────────────────────────────────────────────────────────────────────────────
# Zones-only chart. Set to 1 to bring the extra objects back.
# ─────────────────────────────────────────────────────────────────────────────
ACCUMULATION_ENABLED=0
PROJECT_ROUND_LEVELS=0

# ─────────────────────────────────────────────────────────────────────────────
# Data source — "mt5" (live, via MetaTrader Python API) or "csv" (offline)
# ─────────────────────────────────────────────────────────────────────────────
DATA_SOURCE=mt5

# ─────────────────────────────────────────────────────────────────────────────
# Optional: override the install dir (only set if you moved the app
# after install and want to keep using its data files in-place).
# ─────────────────────────────────────────────────────────────────────────────
# SZP_BASE_DIR=C:\Program Files\SmartZonesPro

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Binance futures (public, no key needed for the free tier we use).
# Reserved for future expansion (rate-limit headers, dedicated proxy, etc).
# ─────────────────────────────────────────────────────────────────────────────
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# H4 incremental zone lifecycle
# The active snapshot changes only on a new closed H4 bar.
# TEST_INVALIDATES_ZONE=true removes a zone after a confirmed H4 test.
# ─────────────────────────────────────────────────────────────────────────────
TEST_INVALIDATES_ZONE=true
ZONE_EVENT_LOG_ENABLED=true

# Adaptive zone width: fixed, atr, or regime.
ZONE_WIDTH_MODE=atr
ATR_PERIOD=14
ATR_MULTIPLIER=0.5
ZONE_WIDTH_MIN=0.50
ZONE_WIDTH_MAX=8.00
REGIME_ATR_LOW=2.0
REGIME_ATR_HIGH=6.0

# ── Отбор зон: поведение старой версии (по умолчанию) ───────────────────────
# USE_ZONE_LADDER=false      — никакой лестницы 3+3, просто топ по score
# USE_ZONE_LADDER=true       — вернуть сетку слотов по расстоянию от цены
USE_ZONE_LADDER=false
MAX_ZONES_ON_CHART=6
# Скоп — вся ширина окна в пунктах. 800 = 400 вверх и 400 вниз от цены.
# Если в скопе зон меньше MAX_ZONES_ON_CHART — рисуем сколько есть.
ZONE_SCOPE_PIPS=800
MAX_ZONE_DISTANCE_PIPS=400
ZONE_WINDOW_ATR=0
# Жизненный цикл зон как в старой версии
LEGACY_ZONE_LIFECYCLE=true
LEGACY_BREAKOUT_LOOKBACK=15
LEGACY_BREAKOUT_MIN=2
LEGACY_ARCHIVE_MIN_SCORE=12
LEGACY_HIST_SCORE_PENALTY=2
LEGACY_HIST_SCORE_FLOOR=8
